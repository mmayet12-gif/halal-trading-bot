# ─── BitGet API Credentials ───────────────────────────────────────────────────
# Get these from: BitGet account → API Management
# Required permissions: Spot Trading only
# IMPORTANT: Withdrawals MUST be OFF. IP whitelist strongly recommended.
BITGET_API_KEY=your_api_key_here
BITGET_SECRET_KEY=your_secret_key_here
BITGET_PASSPHRASE=your_passphrase_here
BITGET_BASE_URL=https://api.bitget.com

# ─── Shariah Compliance ───────────────────────────────────────────────────────
# Trade mode is ALWAYS "spot" — futures/margin involve riba (interest) and are haram.
# This setting cannot be changed. The bot enforces spot-only execution.
# TRADE_MODE=spot  ← hardcoded, not configurable

# ─── Portfolio & Trade Limits ─────────────────────────────────────────────────
# Your total portfolio value in USD (used for 1% max risk calculation)
PORTFOLIO_VALUE_USD=1000

# Hard cap per trade — no single order can exceed this value
MAX_TRADE_SIZE_USD=100

# Daily trade limit — the bot stops placing orders after this many per calendar day
MAX_TRADES_PER_DAY=3

# ─── Symbol & Timeframe ───────────────────────────────────────────────────────
# Only trade assets from the HALAL_SYMBOLS whitelist in bot.js
# Default: BTCUSDT — widely considered permissible by contemporary scholars
SYMBOL=BTCUSDT
TIMEFRAME=4H

# ─── Paper Trading ────────────────────────────────────────────────────────────
# true  = logs all decisions but NEVER places real orders (safe to start here)
# false = live trading — only set this after validating on paper for several days
PAPER_TRADING=true

# ─── Zakat Settings ───────────────────────────────────────────────────────────
# Nisab threshold in USD — the minimum wealth level at which zakat becomes obligatory.
# Approximately the value of 85g of gold or 595g of silver.
# Update this periodically as gold/silver prices change.
# Check current value at: https://www.goldprice.org (85g gold price)
ZAKAT_NISAB_USD=5000
